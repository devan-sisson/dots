#!/usr/bin/env bash
input=$(cat)

{ read -r cwd
  read -r model
  read -r used_pct
  read -r five_hour
  read -r five_hour_resets_at
  read -r seven_day
  read -r seven_day_resets_at
  read -r vim_mode
  read -r worktree_branch
} < <(jq -r '
  .workspace.current_dir // .cwd // "",
  .model.display_name // "",
  .context_window.used_percentage // "",
  .rate_limits.five_hour.used_percentage // "",
  .rate_limits.five_hour.resets_at // "",
  .rate_limits.seven_day.used_percentage // "",
  .rate_limits.seven_day.resets_at // "",
  .vim.mode // "",
  .worktree.branch // ""
' <<<"$input")

now=$(date +%s)

RST='\033[0m' DIM='\033[2m'
CYN='\033[36m' GRN='\033[32m' YEL='\033[33m' RED='\033[31m' MAG='\033[35m' BLU='\033[34m'

color_pct() {
  local v=$(printf "%.0f" "$1")
  if [ "$v" -ge 80 ]; then echo "$RED"
  elif [ "$v" -ge 50 ]; then echo "$YEL"
  else echo "$GRN"; fi
}

color_pace() {
  local u="$1" sl="$2" near="$3" elapsed_pct="$4"
  if [ "$sl" -lt "$near" ]; then
    local colors=("$RED" "$YEL" "$GRN" "$CYN" "$BLU" "$MAG")
    printf '%s' "${colors[$(( now % 6 ))]}"
    return
  fi
  if [ "$elapsed_pct" -le 0 ]; then
    printf '%s' "$GRN"
    return
  fi
  local ratio=$(( u * 100 / elapsed_pct ))
  if [ "$ratio" -ge 200 ]; then printf '%s' "$RED"
  elif [ "$ratio" -gt 100 ]; then printf '%s' "$YEL"
  else printf '%s' "$GRN"
  fi
}

rainbow() {
  local text="$1"
  local colors=("31" "33" "32" "36" "34" "35")
  local n=${#colors[@]}
  local phase=$(( now % n ))
  local result="" i=0 len=${#text}
  while [ $i -lt $len ]; do
    result+="\033[1;${colors[$(( (i + phase) % n ))]}m${text:$i:1}"
    i=$(( i + 1 ))
  done
  printf '%s%b' "$result" "$RST"
}

fmt_countdown() {
  local sl="$1" near="$2" u="$3" elapsed_pct="$4"
  [ "$sl" -le 0 ] && return
  local h=$(( sl / 3600 )) m=$(( (sl % 3600) / 60 )) t
  if [ "$h" -gt 0 ]; then t="${h}h${m}m"; else t="${m}m"; fi
  if [ "$sl" -lt "$near" ]; then
    rainbow "(${t})"
    return
  fi
  local c="$GRN"
  if [ "$elapsed_pct" -ge 5 ] && [ "$u" -gt 0 ]; then
    local ratio=$(( u * 100 / elapsed_pct ))
    if [ "$ratio" -gt 150 ]; then c="$RED"
    elif [ "$ratio" -gt 100 ]; then c="$YEL"; fi
  fi
  printf '%s' "${c}(${t})${RST}"
}

# ---------------------------------------------------------------- team usage
# Org overage spend (extra_usage) from the claude.ai usage endpoint. Not in the
# statusline payload, so we fetch it ourselves: at most once per ORG_TTL, always
# in the background, and always render from cache so a 1s refresh never blocks.
CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/claude-statusline"
ORG_CACHE="$CACHE_DIR/org-usage.json"
ORG_STAMP="$CACHE_DIR/org-usage.attempt"
ORG_LOCK="$CACHE_DIR/org-usage.lock"
ORG_TTL=300

file_mtime() { stat -f %m "$1" 2>/dev/null || stat -c %Y "$1" 2>/dev/null; }

# True only when this account belongs to an org with extra usage enabled.
# ~/.claude.json is small, so this is cheap enough to check on every render
# rather than letting a cached answer go stale after a re-login.
in_org() {
  jq -e '.oauthAccount.organizationUuid and .oauthAccount.hasExtraUsageEnabled' \
    "$HOME/.claude.json" >/dev/null 2>&1
}

org_usage_fetch() {
  local tok tmp

  tok=$(security find-generic-password -s "Claude Code-credentials" -w 2>/dev/null \
        | jq -r '.claudeAiOauth.accessToken // empty' 2>/dev/null)
  [ -z "$tok" ] && return

  tmp="$ORG_CACHE.$$"
  # Token goes through a curl config on stdin, never argv (argv is world-readable in ps).
  if printf 'header = "Authorization: Bearer %s"\nheader = "anthropic-beta: oauth-2025-04-20"\n' "$tok" \
       | curl -sS --max-time 10 -K - --url "https://api.anthropic.com/api/oauth/usage" -o "$tmp" 2>/dev/null \
     && jq -e 'type == "object"' "$tmp" >/dev/null 2>&1; then
    mv -f "$tmp" "$ORG_CACHE"
  else
    rm -f "$tmp"
  fi
}

org_usage_refresh() {
  mkdir -p "$CACHE_DIR" 2>/dev/null || return
  local age=$ORG_TTL
  [ -f "$ORG_STAMP" ] && age=$(( now - $(file_mtime "$ORG_STAMP") ))
  [ "$age" -lt "$ORG_TTL" ] && return

  # Clear a lock left behind by a killed refresh.
  if [ -d "$ORG_LOCK" ] && [ $(( now - $(file_mtime "$ORG_LOCK") )) -gt 60 ]; then
    rmdir "$ORG_LOCK" 2>/dev/null
  fi
  mkdir "$ORG_LOCK" 2>/dev/null || return

  ( trap 'rmdir "$ORG_LOCK" 2>/dev/null' EXIT
    touch "$ORG_STAMP"
    org_usage_fetch
  ) >/dev/null 2>&1 &
  disown 2>/dev/null
}

render_org_usage() {
  [ -f "$ORG_CACHE" ] || return
  local enabled used_minor exp cur limit_minor pct capped amount c part
  { read -r enabled
    read -r used_minor
    read -r exp
    read -r cur
    read -r limit_minor
    read -r pct
    read -r capped
  } < <(jq -r '
    (.spend.enabled // .extra_usage.is_enabled // false),
    (.spend.used.amount_minor // .extra_usage.used_credits // ""),
    (.spend.used.exponent // .extra_usage.decimal_places // 2),
    (.spend.used.currency // .extra_usage.currency // "USD"),
    (.spend.limit.amount_minor // ""),
    (.spend.percent // .extra_usage.utilization // ""),
    (.extra_usage.spend_limit_reached // false)
  ' "$ORG_CACHE" 2>/dev/null)

  [ "$enabled" = "true" ] || return
  [ -n "$used_minor" ] || return

  # Credits arrive in minor units (27173 + exponent 2 -> 271.73).
  amount=$(awk -v m="$used_minor" -v e="$exp" \
    'BEGIN { printf "%." e "f", m / (10 ^ e) }')
  [ "$cur" = "USD" ] && amount="\$${amount}" || amount="${amount} ${cur}"

  # A percentage is only meaningful when the org has a spend limit set;
  # with no limit the endpoint reports percent 0 forever, so show spend alone.
  if [ "$capped" = "true" ]; then
    c="$RED"
  elif [ -n "$limit_minor" ] && [ -n "$pct" ]; then
    c=$(color_pct "$pct")
  else
    c="$GRN"
  fi

  part="${c}${amount}${RST}"
  if [ -n "$limit_minor" ] && [ -n "$pct" ]; then
    part="${part}${DIM}/$(printf '%.0f' "$pct")%${RST}"
  fi
  printf ' %b|%b team:%b' "$DIM" "$RST" "$part"
}

render_window() {
  local label="$1" pct="$2" resets_at="$3"
  [ -z "$pct" ] && return
  local p=$(printf "%.0f" "$pct") c part
  if [ -n "$resets_at" ]; then
    local total near
    case "$label" in
      5h) total=18000;  near=3600  ;;
      7d) total=604800; near=86400 ;;
    esac
    local sl=$(( resets_at - now ))
    local elapsed_pct=$(( (total - sl) * 100 / total ))
    [ "$elapsed_pct" -lt 0 ] && elapsed_pct=0
    [ "$elapsed_pct" -gt 100 ] && elapsed_pct=100
    c=$(color_pace "$p" "$sl" "$near" "$elapsed_pct")
    part="${label}:${c}${p}%${RST}${DIM}/${elapsed_pct}%${RST}$(fmt_countdown "$sl" "$near" "$p" "$elapsed_pct")"
  else
    c=$(color_pct "$pct")
    part="${label}:${c}${p}%${RST}"
  fi
  printf ' %b|%b %s' "$DIM" "$RST" "$part"
}

# Look up the branch from the full path, before it's shortened for display.
branch=""
if [ -n "$worktree_branch" ]; then
  branch="$worktree_branch"
elif [ -n "$cwd" ]; then
  branch=$(git -C "$cwd" symbolic-ref --short HEAD 2>/dev/null || git -C "$cwd" rev-parse --short HEAD 2>/dev/null)
fi

cwd="${cwd/#$HOME\/git\//}"
cwd="${cwd/#$HOME/~}"

wt=""
if [[ "$cwd" == */.claude/worktrees/* ]]; then
  cwd="${cwd#*/.claude/worktrees/}"   # keep worktree name + deeper path
  trees=(🌳 🌲 🌴 🎄 🎋 🌱 🎍 🪴 🌿)
  wt="${trees[$(( now % ${#trees[@]} ))]} "
fi

out=""
[ -n "$cwd" ] && out="${GRN}${wt}${RST}${CYN}${cwd}${RST}"
[ -n "$branch" ] && out="${out} ${DIM}on${RST} ${GRN}${branch}${RST}"
[ -n "$model" ] && out="${out} ${DIM}|${RST} ${MAG}${model}${RST}"

# %u: 1=Mon … 7=Sun
read -r la_dow la_hour < <(TZ=America/Los_Angeles date +'%u %H')
if [ "$la_dow" -ge 1 ] && [ "$la_dow" -le 5 ] && [ "$la_hour" -ge 9 ] && [ "$la_hour" -lt 18 ]; then
  out="${out} ${DIM}|${RST} ${RED}PEAK${RST}"
else
  out="${out} ${DIM}|${RST} ${GRN}off-peak${RST}"
fi

if [ -n "$used_pct" ]; then
  p=$(printf "%.0f" "$used_pct")
  out="${out} ${DIM}| ctx:${RST} $(color_pct "$used_pct")${p}%${RST}"
fi

out="${out}$(render_window 5h "$five_hour" "$five_hour_resets_at")"
out="${out}$(render_window 7d "$seven_day" "$seven_day_resets_at")"

if in_org; then
  org_usage_refresh
  out="${out}$(render_org_usage)"
else
  rm -f "$ORG_CACHE" 2>/dev/null
fi

if [ -n "$vim_mode" ]; then
  [ "$vim_mode" = "INSERT" ] && vc="$YEL" || vc="$BLU"
  out="${out} ${DIM}|${RST} ${vc}${vim_mode}${RST}"
fi

printf '%b' "$out"
