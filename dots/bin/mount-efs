#!/bin/bash

drives=$(aws efs describe-file-systems --output json --no-paginate | jq '[.FileSystems[] | {FileSystemId, Name}]')
names=()
while IFS= read -r n; do names+=("$n"); done < <(echo "$drives" | jq -r '.[].Name // empty')

echo "Select the drive:"
select drive in "${names[@]}"; do
  break
done

FS_ID=$(echo "$drives" | jq -r --arg n "$drive" '.[] | select(.Name == $n) | .FileSystemId')

if [ -z "$FS_ID" ]; then
  echo "No file system found with the name $drive"
  exit 1
fi

IP=$(aws efs describe-mount-targets --file-system-id "$FS_ID" --output json | jq -r '.MountTargets[0].IpAddress // empty')

if [ -z "$IP" ]; then
  echo "No mount target found for file system $FS_ID"
  exit 1
fi

echo "Mounting $FS_ID at $IP to ./efs"

sudo mkdir -p ./efs
sudo mount -t nfs -o vers=4 -o tcp -w "$IP":/ ./efs
cd ./efs
open .
